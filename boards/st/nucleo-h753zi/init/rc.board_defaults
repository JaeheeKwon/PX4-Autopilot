#!/bin/sh

echo "[PX4] applying Nucleo-H753ZI HITL defaults"

# Classical MAVLink HITL airframe.
param set-default SYS_AUTOSTART 1001
param set-default SYS_HITL 1

# The board has no physical mag, but HITL GPS/baro are expected from MAVLink.
param set-default SYS_HAS_MAG 0
param set-default SYS_HAS_BARO 1
param set-default SYS_HAS_GPS 1

# Use HIL GPS for position/velocity/height, with HIL baro still fused.
param set-default EKF2_GPS_CTRL 7
param set-default EKF2_HGT_REF 1
param set-default EKF2_BARO_CTRL 1
param set-default EKF2_MAG_TYPE 5
param set-default EKF2_EV_CTRL 0

# Relax GPS acceptance for simulator startup transients.
param set-default EKF2_REQ_EPH 100.0
param set-default EKF2_REQ_EPV 100.0
param set-default EKF2_REQ_HDRIFT 100.0
param set-default EKF2_REQ_VDRIFT 100.0
param set-default EKF2_DELAY_MAX 300.0

# HIL-only arming and IO behavior.
param set-default COM_ARM_WO_GPS 1
param set-default COM_ARM_MAG_STR 0
param set-default CBRK_SUPPLY_CHK 894281
param set-default CBRK_IO_SAFETY 220127
param set-default COM_RC_IN_MODE 4
param set-default COM_DISARM_PRFLT -1

# USB CDC MAVLink for HITL.
param set-default SYS_USB_AUTO 2
param set-default USB_MAV_MODE 2
