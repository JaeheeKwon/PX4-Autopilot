#!/bin/sh

echo "[PX4] applying Nucleo-H753ZI HITL defaults"

# Classical MAVLink HITL airframe.
param set-default SYS_AUTOSTART 1001
param set-default SYS_HITL 1

# The board has no physical sensors, but HITL mag/GPS/baro are expected from MAVLink.
param set-default SYS_HAS_MAG 1
param set-default SYS_HAS_BARO 1
param set-default SYS_HAS_GPS 1

# Use HIL GPS for position/velocity/height and HIL mag to initialize heading.
param set-default EKF2_GPS_CTRL 7
param set-default EKF2_HGT_REF 1
param set-default EKF2_BARO_CTRL 1
param set-default EKF2_MAG_TYPE 6
param set-default EKF2_MAG_CHECK 0
param set-default EKF2_EV_CTRL 0

# Match the MAVLink simulator EKF/IMU routing defaults used for HITL.
param set-default SENS_IMU_MODE 0
param set-default EKF2_MULTI_IMU 3

# Relax GPS acceptance for simulator startup transients.
param set-default EKF2_REQ_EPH 100.0
param set-default EKF2_REQ_EPV 100.0
param set-default EKF2_REQ_HDRIFT 100.0
param set-default EKF2_REQ_VDRIFT 100.0
param set-default EKF2_DELAY_MAX 300.0

# HIL-only arming and IO behavior.
param set-default COM_ARM_WO_GPS 1
param set-default COM_ARM_MAG_STR 0
param set-default CBRK_SUPPLY_CHK 894281
param set-default CBRK_IO_SAFETY 220127
param set-default COM_RC_IN_MODE 4
param set-default COM_DISARM_PRFLT -1

# USB CDC MAVLink for HITL.
#
# Keep the generated serial startup path away from CN13 USB. HITL traffic on
# /dev/ttyACM0 is owned by cdcacm_autostart, which starts mavlink once VBUS is
# present. If these are saved as TELEM2 they can consume the same USB endpoint
# before the HITL link is ready.
param set-default GPS_1_CONFIG 0
param set-default GPS_2_CONFIG 0
param set-default RC_PORT_CONFIG 0
param set-default MAV_0_CONFIG 0
param set-default MAV_1_CONFIG 0
param set-default MAV_2_CONFIG 0
param set-default SYS_USB_AUTO 2
param set-default USB_MAV_MODE 2

# Dedicated ROS 2 / uXRCE-DDS link on USART6. On the stock MB1364 board use
# PG14/CN12-61 (TX) and PG9/CN11-63 (RX); no solder-bridge change is needed.
# The generated serial startup script owns /dev/ttyS1 as TEL1 and starts the
# client at 921600 baud. MAVLink remains on CN13 USB and must not claim it.
param set-default UXRCE_DDS_CFG 101
param set-default SER_TEL1_BAUD 921600
param set-default UXRCE_DDS_DOM_ID 0
param set-default UXRCE_DDS_KEY 1
param set-default UXRCE_DDS_SYNCT 1
